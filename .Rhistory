dat <- read_excel("./02 - Input/Survey Data/data_2026.xlsx") %>%
filter(consent == 1 & age == 1)
allOptions <- tibble(answer = rep(c("A", "B", "C", "D", "E"), 2), type = c(rep("pre", 5), rep("post", 5)))
q1 <- dat %>%
select(type, q1) %>%
rename(answer = q1) %>%
group_by(answer, type) %>%
count() %>%
full_join(allOptions) %>%
arrange(answer) %>%
mutate(answer_val = ifelse(answer == "E", "Correct", "Incorrect")) %>%
mutate(fill_new = paste(type, answer_val, sep = ", "))
