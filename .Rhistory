q4 <- dat %>%
select(q4, type) %>%
rename(answer = q4) %>%
mutate(answer = ifelse(answer == "B", "Correct", "Incorrect")) %>%
group_by(answer, type) %>%
count() %>%
mutate(fill_new = paste(type, answer, sep = ", "))
View(q4)
