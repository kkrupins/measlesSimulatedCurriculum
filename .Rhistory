dat <- read_excel("./02 - Input/Written Feedback/codedResponses_2026.xlsx") %>%
select(id, primary, secondary, tertiary, quatrinary, quinary) %>%
gather(x, theme, -c(id)) %>%
select(id, theme) %>%
na.omit()
dat2 <- dat %>%
group_by(theme) %>%
count() %>%
arrange(-n) %>%
mutate(theme = factor(theme,
levels = c("Real-world problem solving",
"Lecture format/organization",
"Breakout rooms/share-out time",
"Interactive componenets",
"Taking on the role of a professional",
"Lecturer knowledge & enthusiasm",
"Worksheet inclusion"))) %>%
mutate(percent = (n / 35)*100)
out <- dat2 %>%
ggplot() +
geom_segment(aes(
y = theme,
yend = theme,
x = 0,
xend = n
)) +
geom_point(aes(x = n, y = theme), size = 5, col = "#81a9ad") +
scale_x_continuous(limits = c(0, 8)) +
labs(x = "Number of mentions",
y = element_blank()) +
theme_bw(base_size = 18)
ggsave(
plot = out,
bg = "white",
filename = "./03 - Figures/Rendered/fig4.png",
width = 13,
height = 8
)
